# API_KEY: Required for service API calls.
# The runtime environment may inject this at startup from user secrets.
# Users can configure this via the app secrets panel.
API_KEY="MY_API_KEY"

# APP_URL: The URL where this applet is hosted.
# The runtime environment may inject this at startup with the service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
