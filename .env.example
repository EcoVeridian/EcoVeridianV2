# Firebase web app config (Project settings → General → Your apps → SDK setup).
# These values are public identifiers, not secrets — access control lives in
# Firestore/Storage security rules. Copy this file to .env.local for local dev
# and set the same variables in the Vercel project settings for deploys.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
